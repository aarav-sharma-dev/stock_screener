# Optional secrets (never commit real keys)
XAI_API_KEY=
XAI_MODEL=grok-4-1-fast-non-reasoning
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stock-screener/0.1 by YOUR_REDDIT_USERNAME
# Optional: Slack incoming webhook for new-symbol alerts
# SCREENER_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# Alert only these modes (comma-separated). Empty = all.
# SCREENER_SLACK_MODES=athdip,support
# Append Schwab last prices on Slack/alert lines (default: on when token exists)
# SCREENER_SLACK_SCHWAB_QUOTES=0

# Charles Schwab Trader API — Individual
# https://developer.schwab.com/products/trader-api--individual
# SCHWAB_API_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/
# SCHWAB_TOKEN_PATH=.schwab_token.json
# Account hashValue from `python scripts/schwab_auth.py` (needed for streamer)
# SCHWAB_ACCOUNT_ID=
# Live athdip watcher (scripts/schwab_athdip_watch.py) uses same Slack webhook
